{
  "name": "cottage44-menu",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev docs --ip 127.0.0.1",
    "test": "node --import tsx --test test/*.test.js test/*.test.ts",
    "coverage": "node scripts/coverage.js",
    "test:coverage": "node --experimental-test-coverage --import tsx --test test/*.test.js test/*.test.ts",
    "check": "node --check docs/menu.js && node --check scripts/coverage.js && node --check test/menu.test.js && node --check test/coverage.test.js && tsc --noEmit && test -s docs/index.html && test -s docs/styles.css",
    "build": "wrangler pages functions build functions --outdir .wrangler/functions-build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.148.0"
  }
}
